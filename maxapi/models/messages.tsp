namespace MaxBotApi;

/** Формат текста сообщения */
enum TextFormat {
  markdown: "markdown",
  html: "html",
}

/** Тип связанного сообщения */
enum MessageLinkType {
  forward: "forward",
  reply: "reply",
}

/**
 * Действие, отправляемое участникам чата. Возможные значения:
 * - `"typing_on"` — Бот набирает сообщение
 * - `"sending_photo"` — Бот отправляет фото
 * - `"sending_video"` — Бот отправляет видео
 * - `"sending_audio"` — Бот отправляет аудиофайл
 * - `"sending_file"` — Бот отправляет файл
 */
enum SenderAction {
  typing_on: "typing_on",
  sending_photo: "sending_photo",
  sending_video: "sending_video",
  sending_audio: "sending_audio",
  sending_file: "sending_file",
}

// Определён здесь (а не в models/chats.tsp), т.к. нужен уже для Recipient.chat_type;
// Chat.type (Task 7) переиспользует этот же MaxBotApi.ChatType, а не переобъявляет его.
/**
 * Тип чата.
 *
 * Известные значения: `dialog` — диалог «клиент ↔ бот», `chat` — групповой чат,
 * `channel` — канал. Разбирать их — задача кода, а не схемы.
 *
 * ОТЛИЧИЕ ОТ ОРИГИНАЛА (осознанное, см. DEVIATIONS в scripts/compare.py):
 * оригинал объявляет это перечислением, и перечисление уже подводило. В 0.0.32
 * оно состояло из одного `chat`, хотя описание там же гласило «диалог, чат», а
 * живая платформа отдаёт `dialog` в каждом сообщении диалога: снятый с прода
 * регресс (см. maxbotdemo/README.md) отверг по этой причине все 15 событий.
 * В 0.0.33 набор дополнили до `chat`/`channel`/`dialog`, но сам способ остался
 * хрупким — любое следующее значение снова превратит корректный ответ MAX в
 * ошибку валидации у всех потребителей контракта.
 *
 * Поэтому здесь строка с ограничениями по форме (требование КБ), а не
 * закрытый список. Схема перестаёт ломаться на расширении словаря, известные
 * значения задокументированы выше.
 */
@maxLength(64)
@pattern("^[a-z_]+$")
scalar ChatType extends string;

/** Новый получатель сообщения. Может быть пользователем или чатом */
model Recipient {
  /** ID чата. Как получить ID — в разделе «Получение chat_id» */
  @minValue(0)
  @maxValue(9007199254740991)
  chat_id: int64 | null;

  /** Тип чата */
  chat_type: ChatType;

  /** ID пользователя, если сообщение было отправлено пользователю */
  @minValue(0)
  @maxValue(9007199254740991)
  user_id: int64 | null;
}

/** Статистика сообщения. Возвращается только для постов в каналах */
model MessageStat {
  /** Количество пользователей, которые увидели пост в канале. Просмотр засчитывается, когда пост попадает в область видимости экрана */
  @minValue(0)
  @maxValue(2147483647)
  views: integer;
}

/** Схема, представляющая тело сообщения */
model MessageBody {
  /** Уникальный ID сообщения */
  mid: MessageId;

  /**
   * ID последовательности сообщения в чате.
   *
   * Единственное int64-поле схемы БЕЗ `@maxValue`: его верхняя граница — предел
   * самого типа (2^63-1), а не «JSON-safe» 2^53-1, как у идентификаторов и
   * времени. `seq` не счётчик, а упакованное значение — старшие биты хранят
   * время создания в миллисекундах, младшие счётчик внутри миллисекунды, — и
   * прод отдаёт величины порядка 1.17e17, на порядок выше 2^53-1 (наблюдение
   * зафиксировано в maxmoc/internal/ids/ids.go: mid
   * `mid.000000001a5b94f2019fdaa593db1d43` разбирается в chat_id 442209522 и
   * seq 117052520019991875). Прежняя граница 2^53-1 отвергала любой честный
   * ответ платформы.
   *
   * Записать 2^63-1 через `@maxValue` нельзя: компилятор TypeSpec держит
   * числовые литералы в JS-числах, и всё выше 2^53-1 теряет точность — эмиттер
   * молча выбрасывает такое ограничение. Явный `maximum` дописывает
   * scripts/apply_int_bounds.py.
   */
  @minValue(0)
  seq: int64;

  /** Новый текст сообщения. 4000 — официальный лимит текста сообщения (NewMessageBody.text) */
  @maxLength(4000)
  @pattern("^[\\w\\W]{0,4000}$")
  text: string | null;

  /** Вложения сообщения. Могут быть одним из типов `Attachment`. Смотрите описание схемы */
  @maxItems(100)
  attachments?: Attachment[] | null;

  /** Разметка текста сообщения. Для подробной информации загляните в раздел [Форматирование](/docs-api#Форматирование%20текста%20в%20сообщениях) */
  @maxItems(500)
  markup?: MarkupElement[] | null;
}

/** Пересланное или ответное сообщение */
model LinkedMessage {
  /** Тип связанного сообщения */
  type: MessageLinkType;

  /** Пользователь, отправивший сообщение */
  sender?: User;

  /** Чат, в котором сообщение было изначально опубликовано. Только для пересланных сообщений. Как получить ID — в разделе «Получение chat_id» */
  @minValue(0)
  @maxValue(9007199254740991)
  chat_id?: int64;

  /** Содержимое связанного (пересланного или ответного) сообщения */
  message: MessageBody;
}

/** Сообщение в чате */
model Message {
  /** Пользователь, отправивший сообщение */
  sender?: User;

  /** Получатель сообщения. Может быть пользователем или чатом */
  recipient: Recipient;

  /** Время создания сообщения в формате Unix-time */
  @minValue(0)
  @maxValue(9007199254740991)
  timestamp: int64;

  /** Пересланное или ответное сообщение */
  link?: LinkedMessage | null;

  /** Содержимое сообщения. Текст + вложения. Может быть `null`, если сообщение содержит только пересланное сообщение */
  body: MessageBody;

  /** Статистика сообщения. Возвращается только для постов в каналах */
  stat?: MessageStat | null;

  /** Публичная ссылка на пост в канале. Отсутствует для диалогов и групповых чатов. 2048 — официальный лимит URL в оригинальной схеме (LinkButton.url, LinkMarkup.url) */
  @maxLength(2048)
  @pattern("^[\\w\\W]{0,2048}$")
  url?: string | null;
}

/** Пагинированный список сообщений */
model MessageList {
  /** Массив сообщений */
  @maxItems(100)
  messages: Message[];
}

/** Ссылка на сообщение, которое нужно переслать или на которое нужно ответить */
model NewMessageLink {
  /** Тип ссылки сообщения */
  type: MessageLinkType;

  /** ID исходного сообщения */
  mid: MessageId;
}

/**
 * Новое сообщение, отправляемое ботом.
 *
 * ОТЛИЧИЕ ОТ ОРИГИНАЛА (осознанное, см. DEVIATIONS в scripts/compare.py):
 * `text`, `attachments` и `link` необязательны. Схема, по которой рендерится
 * dev.max.ru (с неё снят reference/), держит их в `required`, но официальная
 * спецификация github.com/max-messenger/api-schema (сентябрь 2026) `required`
 * у этой схемы не содержит вовсе, примеры самой документации шлют тело без
 * `link` и `attachments`, а официальный Go-клиент `link` без ссылки опускает.
 * С `required` строгий валидатор (Atlassian swagger-request-validator на
 * периметре) не пропускал сообщение без ссылки ни одним телом: без поля — нет
 * обязательного свойства, с `null` — `null` не проходит ветвь `allOf`.
 */
model NewMessageBody {
  /** Новый текст сообщения. 4000 — значение из официальной схемы MAX */
  @maxLength(4000)
  @pattern("^[\\w\\W]{0,4000}$")
  text?: string | null;

  /** Вложения сообщения. Если поле не передано или равно `null`, изменений не произойдет. Если массив пуст, все вложения будут удалены */
  @maxItems(100)
  attachments?: AttachmentRequest[] | null;

  /** Ссылка на сообщение, на которое отвечают или которое пересылают. Если ссылки нет, поле не передаётся: `null` строгие по OAS 3.0.3 валидаторы отвергают — ветвь `allOf` его не принимает */
  link?: NewMessageLink | null;

  /** Если false, участники чата не будут уведомлены (по умолчанию `true`) */
  notify?: boolean = true;

  /** Если установлен, текст сообщения будет форматирован данным способом. Для подробной информации загляните в раздел [Форматирование](/docs-api#Форматирование%20текста%20в%20сообщениях) */
  `format`?: TextFormat | null;
}

/** Результат отправки сообщения */
model SendMessageResult {
  /** Отправленное сообщение */
  message: Message;
}

/** Объект, отправленный боту, когда пользователь нажимает кнопку */
model Callback {
  /** Unix-время, когда пользователь нажал кнопку */
  @minValue(0)
  @maxValue(9007199254740991)
  timestamp: int64;

  /** Текущий ID клавиатуры. 1024 — в оригинале лимита нет; по аналогии с официальным лимитом кнопочного payload (CallbackButton.payload) */
  @maxLength(1024)
  @pattern("^[\\w\\W]{0,1024}$")
  callback_id: string;

  /** Токен кнопки. 1024 — официальный лимит источника значения: токен приходит из CallbackButton.payload (maxLength 1024 в оригинале) */
  @maxLength(1024)
  @pattern("^[\\w\\W]{0,1024}$")
  payload?: string;

  /** Пользователь, нажавший на кнопку */
  user: User;
}

/** Отправьте этот объект, когда ваш бот хочет отреагировать на нажатие кнопки */
model CallbackAnswer {
  /** Заполните это, если хотите изменить текущее сообщение */
  message?: NewMessageBody | null;

  /**
   * Одноразовое уведомление пользователю — если сообщение менять не нужно.
   * Есть в официальной спецификации github.com/max-messenger/api-schema, в
   * схеме с dev.max.ru (reference/) отсутствует. 4000 — в оригинале лимита
   * нет; по аналогии с лимитом текста сообщения (NewMessageBody.text)
   */
  @maxLength(4000)
  @pattern("^[\\w\\W]{0,4000}$")
  notification?: string | null;
}

/** Тело запроса на отправку действия отправителя (индикатор набора текста и т. п.) */
model ActionRequestBody {
  /** Действие, отправляемое участникам чата */
  action: SenderAction;
}

/** Тело запроса на закрепление сообщения в чате */
model PinMessageBody {
  /** ID сообщения, которое нужно закрепить. Соответствует полю `Message.body.mid` */
  message_id: MessageId;

  /** Если `true`, участники получат уведомление с системным сообщением о закреплении */
  notify?: boolean | null = true;
}

/** Результат запроса закреплённого сообщения */
model GetPinnedMessageResult {
  /** Закреплённое сообщение. Может быть `null`, если в чате нет закреплённого сообщения */
  message?: Message | null;
}
