namespace MaxBotApi;

/**
 * Объект, описывающий один из вариантов наследования:
 *
 * - `User` — объект содержит общую информацию о пользователе или боте без аватара
 * - `UserWithPhoto` — объект с общей информацией о пользователе или боте, дополнительно содержит URL аватара и описание
 * - `BotInfo` — объект включает общую информацию о боте, URL аватара и описание. Дополнительно содержит список команд, поддерживаемых ботом. Возвращается только при вызове метода `GET /me`
 * - `ChatMember` — объект включает общую информацию о пользователе или боте, URL аватара и описание при его наличии. Дополнительно содержит данные для пользователей-участников чата. Возвращается только при вызове некоторых методов группы `/chats`
 */
model User {
  /** Идентификатор пользователя или бота */
  @minValue(0)
  @maxValue(9007199254740991)
  user_id: int64;

  /** Отображаемое имя пользователя или бота */
  @maxLength(255)
  @pattern("^[\\w\\W]{0,255}$")
  first_name: string;

  /** Отображаемая фамилия пользователя. Для ботов это поле не возвращается */
  @maxLength(255)
  @pattern("^[\\w\\W]{0,255}$")
  last_name?: string | null;

  /** Никнейм бота или уникальное публичное имя пользователя. В случае с пользователем может быть `null`, если тот недоступен или имя не задано */
  @maxLength(255)
  @pattern("^[\\w\\W]{0,255}$")
  username?: string | null;

  /** `true`, если это бот */
  is_bot: boolean;

  /** Время последней активности пользователя или бота в MAX (Unix-время в миллисекундах). Если пользователь отключил в настройках профиля мессенджера MAX возможность видеть, что он в сети онлайн, поле может не возвращаться */
  @minValue(0)
  @maxValue(9007199254740991)
  last_activity_time: int64;

  /** Устаревшее поле, скоро будет удалено */
  @maxLength(255)
  @pattern("^[\\w\\W]{0,255}$")
  name: string | null;
}

// Поля базы вписаны spread'ом, а не через extends: extends эмитится как
// allOf-наследование, а Atlassian swagger-request-validator (валидатор
// периметра) по умолчанию дописывает additionalProperties: false в каждую
// схему с properties, где флаг не задан, — и ветвь allOf базы отвергает поля
// наследника. На живом MAX так падали стикеры и GET /me.
/** Объект с общей информацией о пользователе или боте. Является наследником схемы User — дополнительно к ней содержит URL аватара и описание */
model UserWithPhoto {
  ...User;

  /** Описание пользователя или бота. В случае с пользователем может принимать значение `null`, если описание не заполнено. 16000 — значение из официальной схемы MAX */
  @maxLength(16000)
  @pattern("^[\\w\\W]{0,16000}$")
  description?: string | null;

  /** URL аватара пользователя или бота в уменьшенном размере. 2048 — официальный лимит URL в оригинальной схеме (LinkButton.url, LinkMarkup.url) */
  @maxLength(2048)
  @pattern("^[\\w\\W]{0,2048}$")
  avatar_url?: string;

  /** URL аватара пользователя или бота в полном размере. 2048 — официальный лимит URL в оригинальной схеме (LinkButton.url, LinkMarkup.url) */
  @maxLength(2048)
  @pattern("^[\\w\\W]{0,2048}$")
  full_avatar_url?: string;
}

/** Объект включает общую информацию о боте, URL аватара и описание. Является наследником схемы UserWithPhoto. Дополнительно к ней содержит список команд, поддерживаемых ботом. Возвращается только при вызове метода `GET /me` */
model BotInfo {
  ...UserWithPhoto;

  /** Команды, поддерживаемые ботом */
  @maxItems(32)
  commands?: BotCommand[] | null;
}

/** Команда, поддерживаемая ботом */
model BotCommand {
  /** Название команды. 64 — значение из официальной схемы MAX; pattern — КБ-идиома «любой текст заданной длины» */
  @minLength(1)
  @maxLength(64)
  @pattern("^[\\w\\W]{1,64}$")
  name: string;

  /** Описание команды. 128 — значение из официальной схемы MAX; pattern — КБ-идиома «любой текст заданной длины» */
  @minLength(1)
  @maxLength(128)
  @pattern("^[\\w\\W]{1,128}$")
  description?: string | null;
}

/** Информация о командах бота */
model BotCommandsInfo {
  /** Команды, которые поддерживает бот */
  @maxItems(32)
  commands?: BotCommand[];
}

/** Объект PATCH для обновления команд бота */
model BotCommandsPatch {
  /** Команды, которые поддерживает бот */
  @maxItems(32)
  commands?: BotCommand[];
}

/** Параметры изменения свойств бота */
model BotPatch {
  /** Отображаемое имя пользователя или название бота. 64 — значение из официальной схемы MAX; pattern — КБ-идиома «любой текст заданной длины» */
  @minLength(1)
  @maxLength(64)
  @pattern("^[\\w\\W]{1,64}$")
  first_name?: string | null;

  /** Отображаемое второе имя бота. 64 — значение из официальной схемы MAX; pattern — КБ-идиома «любой текст заданной длины» */
  @minLength(1)
  @maxLength(64)
  @pattern("^[\\w\\W]{1,64}$")
  last_name?: string | null;

  /** Поле устарело, скоро будет удалено. Используйте `first_name`. 64 — официальный лимит first_name, устаревшим алиасом которого является это поле */
  #deprecated "Поле устарело и будет удалено — используйте first_name"
  @maxLength(64)
  @pattern("^[\\w\\W]{0,64}$")
  name?: string | null;

  /** Описание бота. 16000 — значение из официальной схемы MAX; pattern — КБ-идиома «любой текст заданной длины» */
  @minLength(1)
  @maxLength(16000)
  @pattern("^[\\w\\W]{1,16000}$")
  description?: string | null;

  /** Команды, поддерживаемые ботом. Чтобы удалить все команды, передайте пустой список */
  @maxItems(32)
  commands?: BotCommand[] | null;

  /** Запрос на установку фото бота */
  photo?: PhotoAttachmentRequestPayload | null;
}
