namespace MaxBotApi;

/** Статус чата для текущего бота */
enum ChatStatus {
  active: "active",
  removed: "removed",
  left: "left",
  closed: "closed",
}

/** Права администратора группового чата или канала */
enum ChatAdminPermission {
  read_all_messages: "read_all_messages",
  add_remove_members: "add_remove_members",
  add_admins: "add_admins",
  change_chat_info: "change_chat_info",
  pin_message: "pin_message",
  write: "write",
  can_call: "can_call",
  edit_link: "edit_link",
  post_edit_delete_message: "post_edit_delete_message",
  edit_message: "edit_message",
  delete_message: "delete_message",
  edit: "edit",
  delete: "delete",
}

/**
 * Объект содержит общую информацию о групповом чате или канале: его тип,
 * настройки отображения (название, аватар, описание, ссылка), публичную
 * доступность, а также информацию об участниках (владельце, боте и других
 * пользователях), времени их последней активности и событиях
 */
model Chat {
  /** ID чата или канала — в зависимости от ограничений метода и от того, с чем вы работаете. Как получить ID — в разделе «Получение chat_id» */
  @minValue(0)
  @maxValue(9007199254740991)
  chat_id: int64;

  /** Тип чата: `"chat"` — Групповой чат, `"channel"` — Канал, `"dialog"` — Диалог */
  type: ChatType;

  /** Статус чата: `"active"` — Бот является активным участником чата, `"removed"` — Бот был удалён из чата, `"left"` — Бот покинул чат, `"closed"` — Чат был закрыт */
  status: ChatStatus;

  /** Отображаемое название чата или канала. Может быть `null` для диалогов. 200 — официальный лимит названия чата (ChatButton.chat_title, ChatPatch.title) */
  @maxLength(200)
  @pattern("^[\\w\\W]{0,200}$")
  title: string | null;

  /** Иконка чата или канала */
  icon: Image | null;

  /** Время последнего события в чате или канале */
  @minValue(0)
  @maxValue(9007199254740991)
  last_event_time: int64;

  /** Количество участников чата или канала. Для диалогов всегда `2` */
  @minValue(0)
  @maxValue(2147483647)
  participants_count: int32;

  /** ID владельца чата или канала */
  @minValue(0)
  @maxValue(9007199254740991)
  owner_id?: int64 | null;

  /** Участники чата или канала с временем последней активности. Может быть `null`, если запрашивается список чатов */
  participants?: Record<SafeInt64> | null;

  /** Доступен ли чат публично (для диалогов всегда `false`) */
  is_public: boolean;

  /** Ссылка на чат. 2048 — официальный лимит URL в оригинальной схеме (LinkButton.url, LinkMarkup.url) */
  @maxLength(2048)
  @pattern("^[\\w\\W]{0,2048}$")
  link?: string | null;

  /** Описание чата или канала. 400 — официальный лимит описания чата (ChatButton.chat_description) */
  @maxLength(400)
  @pattern("^[\\w\\W]{0,400}$")
  description: string | null;

  /** Данные о пользователе в диалоге (только для чатов типа `"dialog"`) */
  dialog_with_user?: UserWithPhoto | null;

  /** Количество сообщений в групповых чатах и каналах */
  @minValue(0)
  @maxValue(2147483647)
  messages_count?: integer | null;

  /** Закреплённое сообщение в чате (возвращается только при запросе конкретного чата или канала) */
  pinned_message?: Message | null;
}

/** Пагинированный список чатов */
model ChatList {
  /** Список запрашиваемых чатов */
  @maxItems(100)
  chats: Chat[];

  /** Указатель на следующую страницу запрашиваемых чатов */
  @minValue(0)
  @maxValue(9007199254740991)
  marker: int64 | null;
}

/** Параметры изменения свойств чата или канала */
model ChatPatch {
  /** Запрос на изменение иконки чата или канала */
  icon?: PhotoAttachmentRequestPayload | null;

  /** Отображаемое название чата или канала. 200 — значение из официальной схемы MAX */
  @minLength(1)
  @maxLength(200)
  @pattern("^[\\w\\W]{1,200}$")
  title?: string | null;

  // Инлайн (а не scalar MessageId): для nullable-юниона `MessageId | null`
  // эмиттер кладёт $ref внутрь allOf рядом с `type: string` — валидаторы
  // считают такой allOf-с-соседними-ключами анти-паттерном.
  /** ID сообщения для закрепления в чате. Чтобы удалить закреплённое сообщение, используйте метод unpin */
  @minLength(1)
  @maxLength(255)
  @pattern("^[a-zA-Z0-9._\\-]+$")
  pin?: string | null;

  /** Если `true`, участники получат системное уведомление об изменении */
  notify?: boolean | null = true;
}

/**
 * Объект включает общую информацию о пользователе или боте, URL аватара и
 * описание (при наличии). Является наследником схемы UserWithPhoto.
 * Дополнительно к ней содержит данные для пользователей-участников чата или
 * канала. Возвращается только при вызове некоторых методов группы `/chats`
 */
model ChatMember {
  ...UserWithPhoto;

  /** Время последней активности пользователя в чате. Может быть устаревшим для суперчатов (равно времени вступления) */
  @minValue(0)
  @maxValue(9007199254740991)
  last_access_time: int64;

  /** Является ли пользователь владельцем группового чата или канала */
  is_owner: boolean;

  /** Является ли пользователь администратором группового чата или канала */
  is_admin: boolean;

  /** Дата присоединения к чату в формате Unix time */
  @minValue(0)
  @maxValue(9007199254740991)
  join_time: int64;

  /**
   * Перечень прав доступа пользователя или бота, если тот является
   * администратором группового чата или канала. Для обычных участников чата
   * или канала поле не возвращается. 20 — прав в enum всего 13; запас на
   * будущие
   */
  @maxItems(20)
  permissions: ChatAdminPermission[] | null;

  /**
   * Описание роли, которое будет отображаться на клиентском устройстве в
   * настройках чата или канала рядом с именем пользователя
   */
  @maxLength(255)
  @pattern("^[\\w\\W]{0,255}$")
  `alias`?: string;
}

/** Назначить администратора группового чата или канала */
model ChatAdmin {
  /** Идентификатор пользователя-участника группового чата или канала, который назначается администратором. Максимум — 50 администраторов в чате */
  @minValue(0)
  @maxValue(9007199254740991)
  user_id: int64;

  /**
   * Перечень прав доступа пользователя или бота, который назначается
   * администратором группового чата или канала. Если право назначается
   * действующему администратору, то его текущие права будут обновлены в
   * соответствии с переданным списком. 20 — прав в enum всего 13; запас на
   * будущие
   */
  @maxItems(20)
  permissions: ChatAdminPermission[];

  /**
   * Описание роли, которое будет отображаться на клиентском устройстве в
   * настройках чата или канала рядом с именем пользователя
   */
  @maxLength(255)
  @pattern("^[\\w\\W]{0,255}$")
  `alias`?: string;
}

/** Пагинированный список участников группового чата или канала */
model ChatMembersList {
  /**
   * Список участников группового чата или канала с общей информацией о них,
   * а также временем последней активности и списком прав доступа для
   * пользователей и ботов, которые являются администраторами
   */
  @maxItems(100)
  members: ChatMember[];

  /** Указатель на следующую страницу данных */
  @minValue(0)
  @maxValue(9007199254740991)
  marker?: int64 | null;
}

/** Пагинированный список администраторов группового чата или канала */
model ChatAdminsList {
  /** Список пользователей и ботов, которые получат права администратора группового чата или канала. 50 — документированный максимум администраторов в чате */
  @maxItems(50)
  admins: ChatAdmin[];

  /** Указатель на следующую страницу данных */
  @minValue(0)
  @maxValue(9007199254740991)
  marker?: int64 | null;
}

/**
 * Список ID пользователей.
 *
 * ОТЛИЧИЕ ОТ ОРИГИНАЛА (осознанное, см. DEVIATIONS в scripts/compare.py):
 * в оригинальной схеме `user_ids` описан как параметро-подобная структура
 * (name/required/schema/style) с maxItems, заданным строкой ("100") на
 * уровне items, а не массива — явный артефакт копипасты из описания
 * параметра запроса. Мы транскрибируем содержательный смысл: обычное
 * свойство-массив с ограничением на количество элементов.
 */
model UserIdsList {
  /** Массив ID пользователей, которых вы хотите добавить в групповой чат. В одном запросе можно передать максимум 100 идентификаторов */
  @maxItems(100)
  user_ids: SafeInt64[];
}

/** Результат запроса на изменение списка участников */
model ModifyMembersResult extends SimpleQueryResult {
  /** ID пользователей, которых не удалось добавить в групповой чат */
  @maxItems(100)
  failed_user_ids?: SafeInt64[] | null;

  /** Подробное объяснение, почему пользователь не был добавлен в групповой чат */
  @maxItems(100)
  failed_user_details?: FailedUserDetails[] | null;
}

/** Подробное описание, почему пользователь не был добавлен в групповой чат или канал */
model FailedUserDetails {
  /**
   * Код ошибки. Возможные значения: `add.participant.privacy` — ошибки
   * конфиденциальности при добавлении пользователей; `add.participant.not.found`
   * — пользователи не найдены
   */
  @maxLength(255)
  @pattern("^[\\w\\W]{0,255}$")
  error_code: string;

  /** ID пользователей с данной ошибкой */
  @maxItems(100)
  user_ids: SafeInt64[];
}
